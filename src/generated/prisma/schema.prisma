generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id               Int                @id @default(autoincrement())
  name             String             @db.VarChar(255)
  email            String             @unique(map: "customers_unique") @db.VarChar(255)
  address_id       Int?
  country_code     String?            @db.VarChar(255)
  phone_number     String?            @db.VarChar(255)
  customer_type    String             @db.VarChar(255)
  password_hash    String             @db.VarChar(255)
  plan_tier        plan_tier?
  role             user_role?         @default(USER)
  customer_system  customer_system[]
  notification     Notifications?
  orders           orders[]
  setting          Settings?
  software_tickets software_tickets[]
  tower_logs       tower_logs[]
  tower            Towers[]

  @@map("customers")
}

model Settings {
  settings_id        Int       @id @default(autoincrement())
  customer_id        Int?      @unique(map: "settings_customer_unique")
  theme              String?   @db.VarChar(10)
  time_zone          String?   @db.VarChar(100)
  text_size          String    @default("Medium") @db.VarChar(20)
  bold_text          Boolean?
  update_frequency   String?   @db.VarChar(50)
  region             String?   @db.VarChar(100)
  language           String?   @db.VarChar(5)
  twentyfourhourtime Boolean?
  last_login_device  String    @default("N/A") @db.VarChar(100)
  last_login         DateTime  @default(now()) @db.Timestamptz(0)
  email_recovery     String?   @db.VarChar(255)
  phone_recovery     String?   @db.VarChar(20)
  customer           Customer? @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_settings_customer")

  @@map("settings")
}

model Systems {
  id                 Int               @id @default(autoincrement())
  system_name        String            @db.VarChar(100)
  inverter_type      String?           @db.VarChar(100)
  timezone           String?           @db.VarChar(50)
  installation_date  DateTime?         @db.Date
  status             String?           @default("ACTIVE") @db.VarChar(50)
  total_towers       Int?              @default(0)
  max_pv_kw          Decimal?          @default(0) @db.Decimal(10, 2)
  software_version   String?           @db.VarChar(50)
  latitude           Decimal           @default(0) @db.Decimal(9, 7)
  longitude          Decimal           @default(0) @db.Decimal(10, 7)
  system_cipher      String?           @db.VarChar(512)
  system_iv          String?           @db.VarChar(32)
  system_tag         String?           @db.VarChar(32)
  has_fronius_system Boolean           @default(false)
  customer_system    customer_system[]
  towers             Towers[]

  @@unique([latitude, longitude], map: "unique_physical_system_geo")
  @@map("systems")
}

model Notifications {
  notifications_id           Int       @id @default(autoincrement())
  customer_id                Int?      @unique(map: "notifications_customer_unique")
  push_notifications_enabled Boolean?
  push_notify_login          Boolean?
  notification_tone          String?   @db.VarChar(100)
  email_marketing            Boolean?
  email_account_activity     Boolean?
  email_newsletter           Boolean?
  sms_password_changes       Boolean?
  sms_login_attempts         Boolean?
  customer                   Customer? @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_notification_customer")

  @@map("notifications")
}

model Towers {
  id               Int          @id @default(autoincrement())
  model            String       @db.VarChar(255)
  latitude         Decimal      @db.Decimal(8, 6)
  longitude        Decimal      @db.Decimal(9, 6)
  customer_id      Int
  order_id         Int
  state            Int?
  c_group          Int
  error_state      Int
  length           Int
  height           Int
  width            Int
  software_version String?
  current_angle    Decimal?     @db.Decimal(5, 2)
  system_id        Int?
  tower_logs       tower_logs[]
  customer         Customer     @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_towers_customer")
  orders           orders       @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_towers_order")
  system           Systems?     @relation(fields: [system_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_towers_systems")

  @@map("towers")
}

model Telemetry {
  id           Int      @id @default(autoincrement())
  date_time    DateTime @default(now()) @db.Timestamptz(6)
  tower_id     Int
  humidity     Float?
  temperature  Float?
  pressure     Float?
  status       Int?
  power_output Float
  clouds       Boolean?
  solar_flux   Int?
  angle        Float?

  @@map("telemetry")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model addresses {
  id              Int
  line_1          String? @db.VarChar(255)
  line_2          String? @db.VarChar(255)
  line_3          String? @db.VarChar(255)
  line_4          String? @db.VarChar(255)
  city            String? @db.VarChar(255)
  county_province String? @db.VarChar(255)
  zip_postcode    String? @db.VarChar(255)
  country         String? @db.VarChar(255)
  other           String? @db.VarChar(1000)

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model components {
  id       Int
  l_sensor Int
  h_sensor Int
  t_sensor Int
  p_sensor Int
  l_switch Int
  compass  Int
  motor    Int
  panels   Int
  relay    Int
  wiper    Int

  @@ignore
}

model energy {
  day    Int
  month  Int
  year   Int
  tower  Int
  energy Float?
  id     Int    @id @default(autoincrement())
}

model orders {
  id               Int      @id @default(autoincrement())
  customer_id      Int
  tower_count      Int
  address_id       Int
  price            Int
  currency         String   @db.VarChar(255)
  state            String   @db.VarChar(255)
  date_time        DateTime @db.Timestamptz(6)
  payment_received Boolean
  customers        Customer @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_orders_customer")
  towers           Towers[]
}

model software_tickets {
  id          Int      @id @default(autoincrement())
  customer_id Int
  email       String   @db.VarChar(255)
  subject     String   @db.VarChar(255)
  message     String   @db.VarChar(3000)
  date_time   DateTime @default(now()) @db.Timestamptz(6)
  handled     Boolean
  customers   Customer @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_stickets_customer")
}

model tower_logs {
  id          Int      @id
  customer_id Int
  type        String   @db.VarChar(255)
  message     String   @db.VarChar(3000)
  date_time   DateTime @default(now()) @db.Timestamptz(6)
  tower_id    Int?
  closed      Boolean
  customers   Customer @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tlogs_customer")
  towers      Towers?  @relation(fields: [tower_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tlogs_tower")
}

model users {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
}

model customer_system {
  customer_id Int
  system_id   Int
  role        String?  @default("OWNER") @db.VarChar(20)
  customers   Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  systems     Systems  @relation(fields: [system_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([customer_id, system_id])
}

enum plan_tier {
  RESIDENTIAL
  COMMERCIAL
}

enum user_role {
  USER
  ADMIN
}
